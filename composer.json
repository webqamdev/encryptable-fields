{
    "name": "webqamdev/encryptable-fields",
    "description": "Laravel Eloquent Fields Encryptable",
    "keywords": [
        "webqamdev",
        "webqamdeveloppement",
        "thomascombe",
        "encryptable-fields"
    ],
    "homepage": "https://github.com/webqamdev/encryptable-fields",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jérémy ARGOUD",
            "email": "jargoud@webqam.fr",
            "role": "Developer"
        },
        {
            "name": "Robin DESORME",
            "email": "rdesorme@webqam.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-json": "*",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Webqamdev\\EncryptableFields\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webqamdev\\EncryptableFields\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webqamdev\\EncryptableFields\\EncryptableFieldsServiceProvider"
            ]
        }
    }
}
